{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fog-of-time.local/schema/theoretical-creature-v1.json",
  "title": "Fog of Time theoretical creature",
  "description": "A hypothesised animal. Its life is the life of the hypothesis: each event is one publication taking a stance on it, in publication-year order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "hypothesis", "events"],
  "properties": {
    "schema_version": { "const": "fog-of-time.theoretical-creature/v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "scientific_name": { "type": ["string", "null"] },
    "hypothesis": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stance", "summary", "publication"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stance": { "enum": ["proposes", "supports", "revises", "challenges", "refutes", "revives", "confirms"] },
          "summary": { "type": "string", "minLength": 1 },
          "publication": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "year", "authors"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "doi": { "type": ["string", "null"] },
              "title": { "type": "string", "minLength": 1 },
              "year": { "type": "integer", "minimum": 1600, "maximum": 2100 },
              "journal": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] },
              "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
