{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fog-of-time.local/schema/theoretical-creature-v3.json",
  "title": "Fog of Time theoretical creature",
  "description": "A hypothesis about an animal whose life is argued over in the taxonomic claims of ingested papers. Name usage (identified_as) cannot count for or against it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "hypothesis",
    "taxa",
    "rules",
    "key_events"
  ],
  "properties": {
    "schema_version": {
      "const": "fog-of-time.theoretical-creature/v3"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "scientific_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "taxa": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "for": {
          "$ref": "#/$defs/rules"
        },
        "against": {
          "$ref": "#/$defs/rules"
        }
      }
    },
    "key_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publication_id",
          "stance"
        ],
        "properties": {
          "publication_id": {
            "type": "string",
            "minLength": 1,
            "description": "An ingested publication id from data/extracted."
          },
          "stance": {
            "enum": [
              "proposes",
              "recorded",
              "supports",
              "challenges",
              "refutes",
              "revives"
            ],
            "description": "refutes/revives need an argued (stated with evidence) claim; supports/challenges a stated one. A weaker claim needs a rationale."
          },
          "opinion_id": {
            "type": "string",
            "minLength": 1,
            "description": "Pin the turning point to one of the paper's claims."
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "Curator's reason, required when the cited claim is weaker than the stance needs."
          }
        }
      }
    }
  },
  "$defs": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/status"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Related-taxon prefixes, e.g. 'Tyrannosaurus' matches 'Tyrannosaurus rex'."
          }
        }
      }
    },
    "status": {
      "enum": [
        "belongs_to",
        "subjective_synonym_of",
        "objective_synonym_of",
        "replaced_by",
        "invalid_subgroup_of",
        "misspelling_of",
        "nomen_dubium",
        "nomen_nudum",
        "nomen_vanum",
        "nomen_oblitum",
        "sister_to"
      ]
    }
  }
}
